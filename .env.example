# =============================================================================
# Elia Back — скопируй в .env и заполни
#   cp .env.example .env
# =============================================================================

# --- Сервер ---
PORT=3001
NODE_ENV=development

# --- CORS ---
# URL фронта, с которого идут запросы к API.
# Локально: http://localhost:5173
# Прод (Cloud Run): https://elia-front-xxxxx.run.app
FRONTEND_URL=http://localhost:5173

# --- Neon Postgres (ОБЯЗАТЕЛЬНО) ---
# 1. Зайди на https://console.neon.tech
# 2. Создай проект (например elia-dev)
# 3. Создай базу elia (или оставь neondb)
# 4. Connection details → вкладка «Pooled connection»
# 5. Скопируй строку целиком сюда
#
# Пример (подставь свои user, password, host, db):
# DATABASE_URL=postgresql://elia_user:SECRET@ep-cool-name-12345678.eu-central-1.aws.neon.tech/elia?sslmode=require
DATABASE_URL=

# Прямое подключение (без pooler) — НЕ обязательно для старта.
# Нужно только для psql / тяжёлых миграций. В Neon: «Direct connection».
# DATABASE_URL_UNPOOLED=postgresql://elia_user:SECRET@ep-cool-name-12345678.eu-central-1.aws.neon.tech/elia?sslmode=require

# SSL к Postgres. Для Neon оставь true.
DATABASE_SSL=true

# --- Auth (этап 1) ---
# Секрет для JWT (случайная строка ≥32 символов)
SECRET_KEY=

# Веб-режим: POST /auth/dev-login без VK (только local/dev)
ALLOW_DEV_AUTH=true

# GET /admin/summary — счётчики таблиц (замена Django admin на dev)
ENABLE_ADMIN=true

# VK Mini App
VK_APP_ID=
VK_API_VERSION=5.199

# Сколько соединений держит пул. Локально 10 ок, на Cloud Run можно 5.
DATABASE_POOL_MAX=10

# =============================================================================
# Google Cloud — для деплоя на Cloud Run
# console.cloud.google.com → выбери проект → скопируй Project ID
# =============================================================================

# ID проекта GCP (не название, а project id, например elia-mvp-123456)
GCP_PROJECT_ID=

# Регион Cloud Run и Artifact Registry
GCP_REGION=europe-west1

# Docker-репозиторий в Artifact Registry (создаётся один на проект)
# gcloud artifacts repositories create elia --repository-format=docker --location=$GCP_REGION
GCP_ARTIFACT_REGISTRY=elia

# Имена сервисов Cloud Run
CLOUD_RUN_SERVICE_BACK=elia-back
CLOUD_RUN_SERVICE_FRONT=elia-front

# URL фронта на Cloud Run (после первого деплоя — вставь сюда и в FRONTEND_URL для прода)
# CLOUD_RUN_FRONT_URL=https://elia-front-xxxxx.europe-west1.run.app

# URL бэка на Cloud Run (для фронта в проде → VITE_API_URL в elia_front/.env)
# CLOUD_RUN_BACK_URL=https://elia-back-xxxxx.europe-west1.run.app

# Локальный деплой через gcloud (опционально):
# путь к JSON ключу service account с ролями Run Admin + Artifact Registry Writer
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/elia-deployer.json
